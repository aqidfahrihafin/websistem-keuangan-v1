APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00
APP_VERSION=dev
APP_COMMIT=unknown

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emall_annuqayah
DB_USERNAME=root
DB_PASSWORD=
# Only needed if backups fail with "'mysqldump' is not recognized" - the web
# server's PATH often doesn't include it even when your terminal's does
# (common on Windows/Laragon). Point this at the folder containing
# mysqldump(.exe)/mysql(.exe). Use forward slashes even on Windows -
# backslashes are parsed as escape sequences in a quoted .env value.
# e.g. C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin
# Kosongkan di Linux/hosting agar mysqldump dan mysql dicari dari PATH.
# Hanya isi jika binary tidak tersedia di PATH (contoh Windows/Laragon:
# C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin).
DB_DUMP_BINARY_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Application-layer protection. A reverse proxy/WAF is still required for DDoS.
RATE_LIMIT_API=120
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTH_SENSITIVE=10
RATE_LIMIT_FINANCIAL=10
RATE_LIMIT_PAYMENT_SYNC=5
RATE_LIMIT_WEBHOOK=120
WALI_TOKEN_EXPIRATION_DAYS=30
WALI_TOKEN_REFRESH_WINDOW_DAYS=7
WALI_QUICK_TOKEN_EXPIRATION_DAYS=365

# Enable in production only after off-site storage and restore tests are ready.
AUTOMATIC_BACKUP_ENABLED=false
AUTOMATIC_BACKUP_TIME=02:00
AUTOMATIC_BACKUP_CLEANUP_TIME=03:00
BACKUP_WARNING_AFTER_HOURS=26
BACKUP_CRITICAL_AFTER_HOURS=48
BACKUP_OFFSITE_ENABLED=false
BACKUP_OFFSITE_DISK=s3
BACKUP_OFFSITE_PREFIX=emall-backups

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Path to the Firebase service-account JSON (server-side, for sending push
# notifications via FCM). Not the same file as mobile/android/app/google-services.json,
# which is client-side and unrelated to this. Generate at Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key.
FIREBASE_CREDENTIALS=

# Fallback for hosting where the control panel's cron can't run an arbitrary
# shell command - lets an external scheduler (e.g. cron-job.org) trigger
# schedule:run / queue:work by hitting /cron/schedule/{this value} and
# /cron/queue/{this value}. Leave blank to keep those routes disabled (404).
# Generate a random value, e.g.: php -r "echo bin2hex(random_bytes(24));"
CRON_SECRET=
